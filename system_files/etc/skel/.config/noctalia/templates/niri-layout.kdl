// Generated by Noctalia from ~/.config/noctalia/templates/niri-layout.kdl - edit that file, not
// this one, which is rewritten whenever the theme or wallpaper changes.
//
// The whole layout section lives here rather than only its colours, so niri never has to merge
// two layout blocks from two files. Noctalia's built-in niri template is left off: it paints the
// focused border in full-strength primary.

layout {
    // gaps between windows, plus struts, give the 3px-in / 8px-out spacing of the Hyprland setup
    gaps 6
    struts {
        left 2
        right 2
        top 2
        bottom 2
    }

    center-focused-column "never"
    background-color "transparent" // Noctalia draws the wallpaper

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // One 2px border in the palette: a faint primary on the focused window, fainter text colour
    // on the rest. The focus ring is the second, outer outline niri draws; one is enough.
    focus-ring {
        off
    }

    border {
        width 2
        active-color   "{{colors.primary.default.hex}}4d"
        inactive-color "{{colors.on_surface.default.hex}}1a"
        urgent-color   "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
