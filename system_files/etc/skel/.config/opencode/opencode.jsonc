{
  "$schema": "https://opencode.ai/config.json",

  // Devin, the local agent, as a model (claude-devin-acp, the claude-devin-serve user service):
  // every reply is a Devin session working with its own tools and sandbox. No timeout, since a
  // Devin turn can run for many minutes.
  "provider": {
    "devin": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Devin (local agent)",
      // The server's token, made on its first start and readable by this user alone.
      "options": {
        "baseURL": "http://127.0.0.1:47821/v1",
        "apiKey": "{file:~/.local/state/claude-devin-acp/token}",
        "timeout": false
      },
      // Always SWE-2, by Devin's own names for how hard it thinks. The names are what a subagent's
      // label ends with ("Devin Subagent — task · SWE-2 High") when the model is passed.
      "models": {
        "swe-2-medium": { "name": "SWE-2 Medium" },
        "swe-2-high": { "name": "SWE-2 High" },
        "swe-2-max": { "name": "SWE-2 Max" }
      }
    }
  },

  // Claude hands work to Devin through this subagent, from OpenCode's own subagent tool.
  "agent": {
    "devin": {
      "mode": "subagent",
      "model": "devin/swe-2-high",
      "description": "Devin, a separate coding agent on this machine with its own tools and sandbox. Hand it a complete, self-contained task, ideally in the background: exploring a codebase, implementing, reviewing, long tasks."
    }
  },

  // The same server's MCP side: devin watches and steers Devin subagents while they work, which
  // OpenCode itself would hold until Devin's whole turn ends; subagents does the same for
  // OpenCode's own subagents on any other model (DeepSeek while Devin is rate limited).
  "mcp": {
    "servers": {
      "devin": {
        "type": "remote",
        "url": "http://127.0.0.1:47821/mcp",
        "headers": { "Authorization": "Bearer {file:~/.local/state/claude-devin-acp/token}" },
        "oauth": false,
        "codemode": false
      },
      "subagents": {
        "type": "remote",
        "url": "http://127.0.0.1:47821/mcp/subagents",
        "headers": { "Authorization": "Bearer {file:~/.local/state/claude-devin-acp/token}" },
        "oauth": false,
        "codemode": false
      }
    }
  },

  // The boundary. Every command the shell tool runs goes through this wrapper,
  // which bubblewraps it: the filesystem read-only, the project and /tmp
  // writable, build caches writable, credentials shadowed. The rules below are
  // therefore about accidents, not containment.
  "shell": "/usr/libexec/atomic-niri/bwrap-shell",

  "permissions": [
    // ── The native file tools do not go through the sandbox, so this is the ──
    // ── only boundary they have. Anything outside the project asks first. ────
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.cargo/registry/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/worktree/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },

    { "action": "read", "resource": "~/.cargo/registry/*", "effect": "allow" },
    { "action": "read", "resource": "~/.local/share/opencode/worktree/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "~/.local/share/opencode/worktree/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },

    // ── Credentials: denied to every tool, no prompt offered. The sandbox ────
    // ── hides these from the shell; this covers the native file tools. ───────
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/state/opencode/service.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/state/claude-devin-acp/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/state/opencode/service.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/state/claude-devin-acp/*", "effect": "deny" },

    // ── Shell: everything runs; the sandbox is what stops it. This list is a ─
    // ── speed bump for accidents. Any interpreter can wrap a command the ─────
    // ── scanner cannot see into, so treat it as advice, not a guarantee. ─────
    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf $HOME*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -f*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "pkill -f *", "effect": "deny" },
    { "action": "shell", "resource": "killall *", "effect": "deny" },
    { "action": "shell", "resource": "kill -9 -1", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R *", "effect": "deny" },
    { "action": "shell", "resource": "chown -R *", "effect": "deny" }
  ],

  // Runs after the rules and after saved approvals; only ever turns allow or
  // ask into deny. The floor under --auto and under any subagent's own rules.
  "policies": [
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf /*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf ~*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pkill -f *", "effect": "deny" }
  ]
}
